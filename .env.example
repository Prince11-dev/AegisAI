# =====================================
# Application
# =====================================

APP_NAME=AegisAI
APP_ENV=development
APP_DEBUG=true
APP_DESCRIPTION=Enterprise-grade Open Source AI Platform for building LLM, RAG, Agentic AI, and Automation applications.

# =====================================
# API
# =====================================

API_HOST=0.0.0.0
API_PORT=8000

# =====================================
# Database
# =====================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegis_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =====================================
# Redis
# =====================================

REDIS_HOST=localhost
REDIS_PORT=6379

# =====================================
# ChromaDB
# =====================================

CHROMA_HOST=localhost
CHROMA_PORT=8001

# =====================================
# Ollama
# =====================================

OLLAMA_HOST=http://localhost:11434

# =====================================
# Logging
# =====================================

LOG_LEVEL=INFO